# Copy this file to .env for local development. The backend loads it on startup.
# In production, set these values in your hosting platform's environment settings.

# Generate a random secret of at least 32 bytes. The backend refuses to start without it.
JWT_SECRET=

# Set a separate random password of at least 16 bytes before running npm run seed.
ADMIN_PASSWORD=

# "real" = actual Tesseract.js OCR reads the uploaded image.
# "mock" = skip real OCR entirely, always return demo data based on filename keywords.
OCR_MODE=real

# Most hosting platforms set this automatically - only needed for local overrides.
PORT=4000
